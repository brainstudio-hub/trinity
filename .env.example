DATABASE_URL="postgresql://usuario:clave@host:puerto/railway"
AUTH_SECRET="genera-uno-con: npx auth secret"
AUTH_TRUST_HOST=true
APP_URL="http://localhost:3000"

# Opcional: correo transaccional (recuperación de contraseña)
RESEND_API_KEY=""
EMAIL_FROM="Campus Trinity <no-reply@tu-dominio.org>"

# "false" para permitir solo cuentas creadas por el administrador
ALLOW_REGISTRATION=true

# Seed
SEED_ADMIN_EMAIL="coordinacion@tu-dominio.org"
SEED_ADMIN_PASSWORD=""
